# Generated by scripts/generate.py from GitOps {{ manifest_name }}.
# Do not edit manually; update GitOps and re-run generate.py render.

module "{{ r2.module_id }}" {
  source = "../../modules/cloudflare_r2_mirror"

  account_id           = var.cloudflare_account_id
  zone_name            = var.zone_name
  bucket_name          = {{ r2.bucket_name | tojson }}
  custom_domain        = {{ r2.custom_domain | tojson }}
  location             = {{ r2.location | tojson }}
  min_tls              = {{ r2.min_tls | tojson }}
  cors_allowed_origins = {{ r2.cors_allowed_origins | tojson }}
  cors_allowed_methods = {{ r2.cors_allowed_methods | tojson }}
  cors_max_age_seconds = {{ r2.cors_max_age_seconds }}
  token_name           = {{ r2.token_name | tojson }}
}

module "{{ ali.module_id }}" {
  source = "../../modules/alicloud_oss_cdn_mirror"

  cloudflare_zone_name = var.zone_name
  bucket_name          = {{ ali.bucket_name | tojson }}
  oss_region           = {{ ali.oss_region | tojson }}
  oss_acl              = {{ ali.oss_acl | tojson }}
  cdn_domain           = {{ ali.cdn_domain | tojson }}
  cdn_type             = {{ ali.cdn_type | tojson }}
  cdn_scope            = {{ ali.cdn_scope | tojson }}
  cdn_rate_limit       = {{ ali.cdn_rate_limit | tojson }}
  cdn_rate_limit_after = {{ ali.cdn_rate_limit_after | tojson }}
  cors_allowed_origins = {{ ali.cors_allowed_origins | tojson }}
  cors_allowed_methods = {{ ali.cors_allowed_methods | tojson }}
  cors_max_age_seconds = {{ ali.cors_max_age_seconds }}
  ram_user_name        = {{ ali.ram_user_name | tojson }}
  ram_policy_name      = {{ ali.ram_policy_name | tojson }}
  oss_policy_prefixes  = {{ ali.oss_policy_prefixes | tojson }}
}
{%- if ali.cdn_cas_cert_id %}

resource "alicloud_cdn_domain_config" "cn_https_force" {
  domain_name   = module.{{ ali.module_id }}.cdn_domain
  function_name = "https_force"

  function_args {
    arg_name  = "enable"
    arg_value = "on"
  }

  function_args {
    arg_name  = "https_rewrite"
    arg_value = "301"
  }
}
{%- endif %}
{%- if ali.cdn_alarm_contact_group %}

resource "alicloud_cms_alarm" "cn_cdn_bps_alarm" {
  name    = {{ ("client-mirrors-cn-cdn-bps-high" if namespace == "mirrors" else "client-mirrors-" ~ namespace ~ "-cn-cdn-bps-high") | tojson }}
  project = "acs_cdn"
  metric  = "BPS"
  period  = 300
  metric_dimensions = jsonencode([
    {
      instanceId = module.{{ ali.module_id }}.cdn_domain
    }
  ])

  escalations_critical {
    statistics          = "Average"
    comparison_operator = "GreaterThanOrEqualToThreshold"
    threshold           = {{ ali.cdn_bandwidth_alarm_bps | string | tojson }}
    times               = 3
  }

  contact_groups     = [{{ ali.cdn_alarm_contact_group | tojson }}]
  effective_interval = "00:00-23:59"
}
{%- endif %}

output "mirror_summary" {
  value = {
    stack      = {{ stack | tojson }}
    zone_name  = var.zone_name
    probe_path = {{ probe_path | tojson }}
    product_slugs = [
{%- for prod in products %}
      {{ prod.slug | tojson }},
{%- endfor %}
    ]
    cloudflare_r2 = {
      bucket        = module.{{ r2.module_id }}.bucket
      custom_domain = module.{{ r2.module_id }}.custom_domain
      endpoint      = module.{{ r2.module_id }}.endpoint
      vault_kv_path = {{ r2.vault_kv_path | tojson }}
    }
    aliyun_oss = {
      bucket              = module.{{ ali.module_id }}.bucket
      endpoint            = module.{{ ali.module_id }}.endpoint
      cdn_domain          = module.{{ ali.module_id }}.cdn_domain
      cdn_cname           = module.{{ ali.module_id }}.cdn_cname
      oss_region          = {{ ali.oss_region | tojson }}
      cdn_scope           = {{ ali.cdn_scope | tojson }}
      cdn_tls_vault_path  = {{ ali.cdn_tls_vault_path | tojson }}
      oss_policy_prefixes = {{ ali.oss_policy_prefixes | tojson }}
      vault_kv_path       = {{ ali.vault_kv_path | tojson }}
    }
  }
}

output "mirror_credentials" {
  sensitive = true
  value = {
    cloudflare_r2 = {
      vault_kv_path = {{ r2.vault_kv_path | tojson }}
      data = {
        access_key_id     = module.{{ r2.module_id }}.access_key_id
        secret_access_key = module.{{ r2.module_id }}.secret_access_key
        bucket            = module.{{ r2.module_id }}.bucket
        endpoint          = module.{{ r2.module_id }}.endpoint
        custom_domain     = module.{{ r2.module_id }}.custom_domain
      }
    }
    aliyun_oss = {
      vault_kv_path = {{ ali.vault_kv_path | tojson }}
      data = {
        access_key_id     = module.{{ ali.module_id }}.access_key_id
        access_key_secret = module.{{ ali.module_id }}.access_key_secret
        bucket            = module.{{ ali.module_id }}.bucket
        endpoint          = module.{{ ali.module_id }}.endpoint
        cdn_domain        = module.{{ ali.module_id }}.cdn_domain
        oss_region        = {{ ali.oss_region | tojson }}
        cdn_scope         = {{ ali.cdn_scope | tojson }}
      }
    }
  }
}
