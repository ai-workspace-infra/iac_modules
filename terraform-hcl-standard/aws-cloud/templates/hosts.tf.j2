# =============================================================================
# 由 generate.py 从 hosts.yaml 渲染生成 —— 请勿手工编辑
# 重新生成: python3 generate.py render
#
# 约束: 不使用 for_each/count/dynamic 等 HCL 控制结构。
# 每台主机、每个 SSH key 都渲染成独立的显式 module/resource/data 块。
# =============================================================================

data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

{% for key in ssh_keys -%}
resource "aws_key_pair" "{{ key.name | tf_id }}" {
  key_name   = "{{ key.name }}"
  public_key = "{{ key.public }}"
}

{% endfor -%}
{% for host in hosts -%}
{%- set hid = host.name | tf_id -%}
{%- set ephemeral = host.get('lifecycle', 'persistent') == 'ephemeral' or host.get('spot_instance', false) -%}
# ami filter for Debian 12 ARM64
data "aws_ami" "debian_{{ hid }}" {
  most_recent = true
  owners      = ["136693071363"] # Debian

  filter {
    name   = "name"
    values = ["debian-12-arm64-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

resource "aws_security_group" "sg_{{ hid }}" {
  name_prefix = "{{ host.name }}-sg"
  vpc_id      = data.aws_vpc.default.id

{% for cidr in management_cidrs %}
  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["{{ cidr }}"]
  }
{% endfor %}

{% if host.get('role') == 'gateway' %}
{% for cidr in public_cidrs %}
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["{{ cidr }}"]
  }
{% endfor %}
{% endif %}

{% if host.get('role') == 'cpa' and host.get('service_port') %}
  ingress {
    from_port       = {{ host.service_port }}
    to_port         = {{ host.service_port }}
    protocol        = "tcp"
    security_groups = [aws_security_group.sg_{{ (hosts | selectattr('role', 'equalto', 'gateway') | map(attribute='name') | first) | tf_id }}.id]
  }
{% endif %}

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

module "compute_{{ hid }}" {
{% if ephemeral %}
  source = "../../modules/spot_ec2"
{% else %}
  source = "../../modules/ec2"
{% endif %}

  name_prefix = var.name_prefix != "" ? "${var.name_prefix}-{{ host.name }}" : "{{ host.name }}"
  
  instance = {
    type = "{{ host.plan | default('t4g.small') }}"
    ami  = data.aws_ami.debian_{{ hid }}.id
  }

  subnet_id = data.aws_subnets.default.ids[0]
  sg_id     = aws_security_group.sg_{{ hid }}.id
  keypair_name = aws_key_pair.{{ ssh_keys[0].name | tf_id }}.key_name
{% if not ephemeral %}
  elastic_ip = {{ host.get('elastic_ip', false) | tojson }}
  deletion_protection = {{ host.get('deletion_protection', false) | tojson }}
{% endif %}
{% if ephemeral %}
  user_data = <<-EOT
#cloud-config
package_update: false
runcmd:
  - [ bash, -lc, "systemd-run --unit=ai-aggregator-ttl --on-active={{ host.get('max_runtime_minutes', 60) }}m --property=NoNewPrivileges=true /sbin/shutdown -h now" ]
EOT
{% endif %}
  
  tags = merge(
    { for t in concat([var.name_prefix], {{ host.get('tags', []) | tojson }}) : "Tag_${t}" => "true" if t != "" },
    { Name = var.name_prefix != "" ? "${var.name_prefix}-{{ host.name }}" : "{{ host.name }}" }
  )
}

{% endfor -%}

output "cmdb_runtime" {
  description = "name -> {ip, instance_id, os_id}"
  value = {
{% for host in hosts -%}
{%- set hid = host.name | tf_id %}
    "{{ host.name }}" = {
      ip          = module.compute_{{ hid }}.public_ip
      private_ip  = module.compute_{{ hid }}.private_ip
      instance_id = module.compute_{{ hid }}.instance_id
      os_id       = data.aws_ami.debian_{{ hid }}.id
    }
{% endfor -%}
  }
}

output "hosts_summary" {
  description = "name -> public_ip"
  value = {
{% for host in hosts -%}
{%- set hid = host.name | tf_id %}
    "{{ host.name }}" = module.compute_{{ hid }}.public_ip
{% endfor -%}
  }
}
