# =============================================================================
# 由 generate.py 从 hosts.yaml 渲染生成 —— 请勿手工编辑
# 重新生成: python3 generate.py render
#
# 约束: 不使用 for_each/count/dynamic 等 HCL 控制结构。
# 每台主机、每个 SSH key 都渲染成独立的显式 module/resource/data 块。
# (循环在 Python+Jinja2 侧完成，而非 HCL 侧)
# =============================================================================

{% for key in ssh_keys -%}
resource "vultr_ssh_key" "{{ key.name | tf_id }}" {
  name    = "{{ key.name }}"
  ssh_key = "{{ key.public }}"
}

{% endfor -%}
{% for host in hosts -%}
{%- set hid = host.name | tf_id -%}
{%- if (host.os_id is not defined or host.os_id is none) and (host.snapshot_id is not defined or host.snapshot_id is none) %}
data "vultr_os" "{{ hid }}" {
  filter {
    name   = "name"
    values = ["{{ host.os_name }}"]
  }
}
{% endif %}
module "compute_{{ hid }}" {
  source = "../../modules/compute"

  # label/tags 的前缀取自该主机所属那份资源声明的 global.name_prefix, 由
  # generate.py 逐主机解析后写死在这里 —— 不能读 var.name_prefix。多份声明
  # 组合部署时(例如 web-saas + agent-proxy), tfvars 里的 name_prefix 只剩最
  # 后一份文件的值, 用它会给别的域的主机安上不属于自己的前缀, 使同一台主机
  # 的 label 随 profile 组合漂移。label 是 resize 自愈按名反查真实实例的锚点,
  # 必须只由主机自己的声明决定。
  label       = "{{ host.label }}"
  region      = {% if host.region %}"{{ host.region }}"{% else %}var.region{% endif %}

  plan        = "{{ host.plan | default('vc2-4c-8gb') }}"
{% if host.snapshot_id %}
  os_id       = null
  snapshot_id = "{{ host.snapshot_id }}"
{% elif host.os_id %}
  os_id       = {{ host.os_id }}
  snapshot_id = null
{% else %}
  os_id       = data.vultr_os.{{ hid }}.id
  snapshot_id = null
{% endif %}

  enable_ipv6 = {{ 'true' if host.get('enable_ipv6', true) else 'false' }}
  backups     = {{ 'true' if host.get('backups', false) else 'false' }}
  tags        = {{ host.tf_tags | tojson }}
  ssh_key_ids = [{% for k in ssh_keys %}vultr_ssh_key.{{ k.name | tf_id }}.id{{ ", " if not loop.last }}{% endfor %}]
  user_data   = file(var.user_data_file)
}

{% endfor -%}
# 运行时事实：仅暴露 apply 后才确定的动态值。静态字段(os_name/plan/groups/
# host_vars 等)由 generate.py 从 hosts.yaml 合并，最终一起写入 cmdb.json。
output "cmdb_runtime" {
  description = "name -> {ip, instance_id, os_id}"
  value = {
{% for host in hosts -%}
{%- set hid = host.name | tf_id %}
    "{{ host.name }}" = {
      ip          = module.compute_{{ hid }}.main_ip
      instance_id = module.compute_{{ hid }}.instance_id
{% if host.snapshot_id %}
      os_id       = null
{% elif host.os_id %}
      os_id       = {{ host.os_id }}
{% else %}
      os_id       = data.vultr_os.{{ hid }}.id
{% endif %}
    }
{% endfor -%}
  }
}

{% for host in hosts if host.get('data_disk') %}
resource "vultr_block_storage" "data_{{ host.name | tf_id }}" {
  region               = {% if host.region %}"{{ host.region }}"{% else %}var.region{% endif %}
  label                = "{{ host.label }}-data"
  size_gb              = {{ host.data_disk.size_gb }}
  block_type           = "{{ host.data_disk.block_type }}"
  attached_to_instance = module.compute_{{ host.name | tf_id }}.instance_id
  live                 = true
}

output "data_disk_{{ host.name | tf_id }}" {
  value = {
    id       = vultr_block_storage.data_{{ host.name | tf_id }}.id
    mount_id = vultr_block_storage.data_{{ host.name | tf_id }}.mount_id
    size_gb  = vultr_block_storage.data_{{ host.name | tf_id }}.size_gb
  }
}
{% endfor %}

output "hosts_summary" {
  description = "name -> public_ip"
  value = {
{% for host in hosts -%}
{%- set hid = host.name | tf_id %}
    "{{ host.name }}" = module.compute_{{ hid }}.main_ip
{% endfor -%}
  }
}
